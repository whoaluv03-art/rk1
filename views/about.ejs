<%- include('partials/head', { pageTitle, description }) %>
<%- include('partials/header', { company, activePage }) %>

<main class="about-page wrap">
  <section class="about-intro">
    <p class="eyebrow"><%= about.eyebrow %></p>
    <h1 class="section-title"><%= about.title %></h1>
    <p class="about-lead"><%= about.description %></p>
  </section>

  <section class="about-details">
    <div class="about-photo">
      <img src="<%= company.hero.image %>" alt="<%= company.hero.imageAlt %>" loading="lazy">
    </div>
    <div class="about-copy">
      <% about.details.forEach((paragraph) => { %>
        <p><%= paragraph %></p>
      <% }) %>
      <a class="button" href="/#contacts">Обсудить проект
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <section class="about-services">
    <div class="section-head">
      <div><p class="eyebrow">Чем занимаемся</p><h2 class="section-title">От идеи до <em>ключей.</em></h2></div>
    </div>
    <div class="services">
      <% services.forEach((service) => { %>
        <article class="service"><div class="service-number"><%= service.number %></div><h3><%= service.title %></h3><p><%= service.description %></p></article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer', { company }) %>